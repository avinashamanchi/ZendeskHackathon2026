# All keys are server-side only. Never referenced in client components.
# The app runs fully offline without any of these — DEMO_MODE fixtures cover everything.

# Master switch. "true" (default) = all external calls skipped, fixtures used directly.
# Toggle at runtime on stage with Cmd/Ctrl+D.
NEXT_PUBLIC_DEMO_MODE=true

# OpenAI — card copy + legacy-agent simulation (III.7)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Octen — embeddings for circumlocution matching (III.6)
# Docs: https://docs.octen.ai/api-reference/embedding
OCTEN_API_KEY=
OCTEN_API_URL=https://api.octen.ai
OCTEN_MODEL=octen-embedding-4b

# Composio — merchant-side account reads + the resolution write (III.8)
COMPOSIO_API_KEY=
# Composio user id whose connected accounts (Stripe/Shopify/Zendesk) to use
COMPOSIO_USER_ID=default
