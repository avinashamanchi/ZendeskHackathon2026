{
  "name": "wordless-support",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "generate:corpus": "tsx scripts/generate-corpus.ts",
    "generate:rules": "tsx scripts/generate-rules.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:html": "npm run build && node --test tests/rendered-html.test.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:html",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@composio/core": "0.14.0",
    "next": "16.2.11",
    "openai": "6.49.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "5.20260723.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3",
    "ws": "8.21.1"
  },
  "type": "module"
}
